# 复制为 docker-compose.yaml 同目录下的 .env，并修改管理员密码。
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password
REGISTRY_MANAGER_IMAGE=ghcr.io/tianzengde/registry-manager:latest
REGISTRY_MANAGER_PORT=30080
REGISTRY_PUBLIC_URL=localhost:30080
ALLOW_TAG_DELETE=false
# 对外访问地址使用 HTTPS 时，设置为 true。
COOKIE_SECURE=false
