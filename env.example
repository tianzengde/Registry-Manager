# Local development (Nuxt also accepts NUXT_ prefixed equivalents)
REGISTRY_URL=http://127.0.0.1:5000
REGISTRY_PUBLIC_URL=localhost:3000
# Optional credentials for an authenticated upstream Registry
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
DATABASE_PATH=db/registry_manager.db
# Used only when initializing an empty database. Existing users are preserved.
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password
ALLOW_TAG_DELETE=false
# Set true when serving through HTTPS
COOKIE_SECURE=false
